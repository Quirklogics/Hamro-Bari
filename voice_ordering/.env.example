# ==============================================================================
# हाम्रो बारी Voice Orders - environment template
# Copy to `.env` (same folder) and fill in your own values. Never commit `.env`.
# ==============================================================================

APP_ENV=development
APP_NAME="Hamro Baari Voice Orders"
DEBUG=True

# ------------------------------------------------------------------------------
# REQUIRED FOR AI: your own Gemini API key from https://aistudio.google.com/apikey
# This app cannot transcribe or parse orders without it. Leave empty to run in
# manual-entry mode: the UI stays fully usable, speech transcripts are still
# saved, but AI extraction is disabled and the API returns a clear 503.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# Model used for both audio -> text and text -> structured order JSON.
# gemini-3.5-flash-lite: cheapest model that supports audio input + JSON schema.
# Alternatives: gemini-3.8-flash (stronger reasoning, higher cost),
#               gemini-3.5-transcribe (speech-to-text only, no JSON schema).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=1
GEMINI_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# Session / CSRF secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty a random value is generated at startup (sessions end on restart).
# ------------------------------------------------------------------------------
SECRET_KEY=
SESSION_HOURS=8
COOKIE_SECURE=False

# ------------------------------------------------------------------------------
# DATABASE
# Leave empty for local SQLite at instance/voice_orders.db (zero setup).
# For production PostgreSQL (e.g. Supabase), paste the real connection URI:
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# A placeholder value is ignored and SQLite is used instead.
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# Upload / request limits
# ------------------------------------------------------------------------------
MAX_CONTENT_LENGTH_BYTES=12582912
MAX_AUDIO_BYTES=8388608
MAX_TRANSCRIPT_CHARS=2000

# ------------------------------------------------------------------------------
# Rate limits (per client address). Use redis://... for a shared store in prod.
# ------------------------------------------------------------------------------
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per hour
RATELIMIT_TRANSCRIBE=20 per minute
RATELIMIT_PARSE=40 per minute
RATELIMIT_SUBMIT=20 per minute
RATELIMIT_TRACK=60 per minute
RATELIMIT_LOGIN=10 per minute

# ------------------------------------------------------------------------------
# Pagination
# ------------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Extra browser origins allowed to call the API (same-origin always allowed).
EXTRA_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# NOTE ON EXTERNAL SERVICES
# Only Google Gemini needs credentials. Notifications are in-app only: no SMS,
# email or push provider is configured, and the app never claims one was sent.
# ------------------------------------------------------------------------------
