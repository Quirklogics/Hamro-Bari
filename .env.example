# ==============================================================================
# HAMRO BAARI (हाम्रो बारी) - SUPABASE CONFIGURATION TEMPLATE
# Copy this file to .env and insert your Supabase credentials
# ==============================================================================

APP_ENV=development
APP_NAME="Hamro Baari Organic Produce API"
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

SECRET_KEY=change_this_to_a_random_secret_in_production
CORS_ORIGINS=*

# Supabase PostgreSQL Connection String (Transaction Pooler - Port 6543 or Session - Port 5432)
# Supabase Dashboard -> Settings -> Database -> Connection URI
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Client API Config (Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
